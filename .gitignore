# ==========================================
# ATLASKnO - Project .gitignore
# ==========================================

# ------------------------------------------
# Python Core & Bytecode
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyc

# ------------------------------------------
# Virtual Environments
# ------------------------------------------
.env
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# ------------------------------------------
# Build & Distribution (Hatchling)
# ------------------------------------------
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------
# Type Checking & Linting (Ruff, MyPy)
# ------------------------------------------
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# ------------------------------------------
# Testing & Coverage
# ------------------------------------------
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/

# ------------------------------------------
# Documentation (MkDocs)
# ------------------------------------------
site/
*~

# ------------------------------------------
# Data / Local RDF Graph Stores (Optional)
# ------------------------------------------
# Ignore local large dataset dumps or local sqlite DBs generated by RDFLib
*.sqlite
*.sqlite3
*.db

# ------------------------------------------
# IDEs & Text Editors
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.project
.pydevproject
.settings/

# ------------------------------------------
# OS Generated Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
